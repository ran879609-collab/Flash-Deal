# ==============================================================================
# CyclePro Pro — 环境变量配置示例 (.env.example)
# ==============================================================================

# 运行端口 (默认 3000)
PORT=3000

# 生产环境标识 (development / production)
NODE_ENV="development"

# 系统安全 Token 签名密钥 (生产环境请务必更换为强随机字符串)
APP_SECRET="cyclepro_secure_token_secret_key_2026_prod"

# --- 数据库配置 (二选一) ---
# 选项 1: 本地 WAL 持久化存储引擎 (内置默认，零外部依赖，自动持久化于 .data/ 目录)
# 无需额外配置，开箱即用

# 选项 2: 外部 Supabase / PostgreSQL 关系型数据库 (生产级部署选配)
# 对应 SQL 迁移脚本已存放于 migrations/001_initial_schema.sql
# DATABASE_URL="postgresql://postgres:your-db-password@db.xxxx.supabase.co:5432/postgres"
# SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# GEMINI_API_KEY: 如需扩展智能预测或提报建议分析时由平台自动注入
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: 平台托管 URL
APP_URL="MY_APP_URL"
